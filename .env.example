# Optional paid registrar (Paymento) — never commit real secrets.
# Docs: docs/intents/bootstrap-gateway-registrar.md

# HMAC secret from Paymento dashboard (Payment Link webhooks + store IPN)
PAYMENTO_WEBHOOK_SECRET=

# Or set the payment link explicitly (otherwise use --registrar-payment-link default)
GULD_REGISTRAR_PAYMENT_LINK=https://app.paymento.io/payment-link/f1b2b2d170344105b0464c0944db2e21

# Configure BOTH in Paymento to the same URL:
#   Payment Link webhook  →  https://guld.io/api/v1/payment-gateway-webhook
#   Store IPN URL         →  https://guld.io/api/v1/payment-gateway-webhook  (POST)
