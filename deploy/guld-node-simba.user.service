# User unit — Simba testnet bootstrap / miner (runs as the installing login user).
# Paths use systemd %h (= $HOME). Default checkout: ~/guld — edit if needed.
#
# Install:
#   install -m 0644 deploy/guld-node-simba.user.service ~/.config/systemd/user/guld-node-simba.service
#   systemctl --user daemon-reload
#   systemctl --user disable --now guld-node.service   # frees :8545 / :8088 from --dev
#   systemctl --user enable --now guld-node-simba.service
#
# Optional: GULD_FAUCET_KEY in ~/guld/.env (never commit). P2P: sudo ufw allow 4001/tcp
# System-wide User=guld template: deploy/guld-node-simba.service
#
# --miner isysd / --faucet-name isysd are *network account* names (Simba), not the OS user.

[Unit]
Description=Guld node — Simba testnet bootstrap (chain_id 2)
Documentation=https://guld.io/docs/?doc=../deploy/SIMBA.md
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/guld
EnvironmentFile=-%h/guld/.env
# --network simba applies data/networks/simba.json (chain_id 2, p2p 0.0.0.0:4001, auto_mine=false).
# HTTP stays on :8088 so existing nginx proxy_pass keeps working (system unit uses :8080).
# Cap PoW to 1% of one core on shared hosts.
ExecStart=%h/guld/target/release/guld-node \
  --network simba \
  --datadir ./.guld-data/simba \
  --rpc 0.0.0.0:8545 \
  --http 127.0.0.1:8088 \
  --http-static . \
  --keys-pgp archives/keys-pgp \
  --miner isysd \
  --mine-cpu-percent 1 \
  --faucet-name isysd \
  --registrar-payment-link default
Restart=on-failure
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=default.target
